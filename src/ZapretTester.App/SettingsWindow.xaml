<Window x:Class="ZapretTester.App.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Настройки" Width="430" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI">
  <StackPanel Margin="24">
    <TextBlock Text="Тестовых процессов одновременно (1–8)"/><TextBox x:Name="Parallel" Margin="0,5,0,5" AutomationProperties.Name="Количество одновременных тестовых процессов от 1 до 8"/>
    <TextBlock Text="До двух HTTPS-запросов на процесс. Больше процессов может ускорить проверку, но повысить задержки и число тайм-аутов." TextWrapping="Wrap" Foreground="#536171" FontSize="11" Margin="0,0,0,12"/>
    <TextBlock Text="Попыток на endpoint (1–5)"/><TextBox x:Name="Attempts" Margin="0,5,0,12"/>
    <TextBlock Text="Общий таймаут DNS + HTTPS, секунд (1–60)"/><TextBox x:Name="Timeout" Margin="0,5,0,5"/>
    <TextBlock Text="Отклик на карточках включает TCP, TLS и ответ HTTPS, без DNS. Это не игровой или ICMP-пинг." TextWrapping="Wrap" Foreground="#536171" FontSize="11" Margin="0,0,0,12"/>
    <TextBlock Text="Начало / конец тестового пула"/>
    <UniformGrid Columns="2" Margin="0,5,0,12"><TextBox x:Name="First" Margin="0,0,8,0"/><TextBox x:Name="Last"/></UniformGrid>
    <TextBlock Text="Папка League of Legends"/>
    <DockPanel Margin="0,5,0,12"><Button DockPanel.Dock="Right" Content="…" Click="ChooseLeague" Margin="8,0,0,0"/><TextBox x:Name="LeagueFolder" IsReadOnly="True"/></DockPanel>
    <TextBlock Text="Регион League of Legends"/><ComboBox x:Name="LeagueRegion" Margin="0,5,0,12"/>
    <CheckBox x:Name="Auto" Content="Проверять при запуске" Margin="0,0,0,12"/>
    <CheckBox x:Name="Keep" Content="Оставлять основной Zapret после закрытия" Margin="0,0,0,18"/>
    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#B00020" Margin="0,0,0,10"/>
    <Button Content="Сохранить" IsDefault="True" Click="Save" HorizontalAlignment="Right" Margin="0"/>
  </StackPanel>
</Window>
