<Window x:Name="RootWindow" x:Class="ZapretTester.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zapret Tester" Width="1390" Height="780" MinWidth="1150" MinHeight="650" Background="#F4F6F8" FontFamily="Segoe UI" FontSize="13" Foreground="#182533">
  <Window.Resources>
    <DataTemplate x:Key="EndpointTemplate">
      <StackPanel Orientation="Horizontal" ToolTip="{Binding Details}" VerticalAlignment="Center">
        <Ellipse Width="9" Height="9" Fill="{Binding Color}" Margin="0,0,7,0"/>
        <TextBlock Text="{Binding Text}" VerticalAlignment="Center"/>
      </StackPanel>
    </DataTemplate>

    <Style x:Key="HintFocus" TargetType="Border">
      <Setter Property="Focusable" Value="True"/>
      <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
      <EventSetter Event="GotKeyboardFocus" Handler="OpenHint"/>
      <EventSetter Event="LostKeyboardFocus" Handler="CloseHint"/>
      <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="#EFF4FA"/></Trigger></Style.Triggers>
    </Style>
    <DataTemplate x:Key="DashboardEndpointTemplate">
      <Border Style="{StaticResource HintFocus}" Width="27" Height="38" CornerRadius="5" Margin="1" AutomationProperties.Name="{Binding Details}">
        <Border.ToolTip><ToolTip><TextBlock Text="{Binding Details}" MaxWidth="380" TextWrapping="Wrap"/></ToolTip></Border.ToolTip>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding ServiceGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" Foreground="#647386"/>
          <TextBlock Text="{Binding Status.Glyph}" FontFamily="Segoe UI Symbol" Foreground="{Binding Status.Color}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Margin="0,3,0,0"/>
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="DashboardHalfTemplate">
      <StackPanel Margin="2,0">
        <Border Style="{StaticResource HintFocus}" Height="98" CornerRadius="9" AutomationProperties.Name="{Binding Details}">
          <Border.ToolTip><ToolTip><TextBlock Text="{Binding Details}" MaxWidth="400" TextWrapping="Wrap"/></ToolTip></Border.ToolTip>
          <Grid>
            <Viewbox Width="43" Height="37" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,7,0,0">
              <Grid Width="64" Height="54">
                <Canvas x:Name="DiscordLogo" Width="64" Height="54" Visibility="Collapsed">
                  <Path Fill="#5865F2" Data="M 14,10 Q 21,6 26,7 L 28,11 L 36,11 L 38,7 Q 47,7 52,12 Q 60,25 60,39 Q 51,47 44,46 L 41,41 Q 32,44 23,41 L 20,46 Q 10,45 4,39 Q 5,23 14,10 Z"/>
                  <Ellipse Width="8" Height="11" Fill="White" Canvas.Left="19" Canvas.Top="23"/><Ellipse Width="8" Height="11" Fill="White" Canvas.Left="37" Canvas.Top="23"/>
                </Canvas>
                <Canvas x:Name="LeagueLogo" Width="64" Height="54" Visibility="Collapsed">
                  <Ellipse Width="48" Height="48" Stroke="#B58B40" StrokeThickness="2.5" Canvas.Left="8" Canvas.Top="3"/>
                  <Path Fill="#B58B40" Data="M 21,8 L 36,8 L 32,13 L 32,38 L 49,38 L 45,46 L 20,46 L 24,40 L 24,13 Z"/>
                </Canvas>
                <Canvas x:Name="YouTubeLogo" Width="64" Height="54" Visibility="Collapsed">
                  <Rectangle Width="60" Height="40" RadiusX="11" RadiusY="11" Fill="#E53935" Canvas.Left="2" Canvas.Top="7"/>
                  <Path Fill="White" Data="M 27,17 L 43,27 L 27,37 Z"/>
                </Canvas>
              </Grid>
            </Viewbox>
            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center">
              <TextBlock Text="{Binding Status.Glyph}" FontFamily="Segoe UI Symbol" FontSize="24" FontWeight="Bold" Foreground="{Binding Status.Color}" HorizontalAlignment="Center"/>
              <TextBlock Text="{Binding Latency}" FontSize="13" Foreground="#536171" HorizontalAlignment="Center" Margin="0,1,0,2"/>
            </StackPanel>
          </Grid>
        </Border>
        <ItemsControl ItemsSource="{Binding Endpoints}" ItemTemplate="{StaticResource DashboardEndpointTemplate}" HorizontalAlignment="Center">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
      <DataTemplate.Triggers><DataTrigger Binding="{Binding IsDiscord}" Value="True"><Setter TargetName="DiscordLogo" Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsLeague}" Value="True"><Setter TargetName="LeagueLogo" Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsYouTube}" Value="True"><Setter TargetName="YouTubeLogo" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="DashboardCardTemplate">
      <Border Width="{Binding CardWidth}" Height="201" Background="White" BorderBrush="{Binding ScoreColor}" BorderThickness="2" CornerRadius="12" Margin="0,0,14,14">
        <Grid Margin="10,9">
          <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="3,1,6,0" VerticalAlignment="Center" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Name}" ToolTip="{Binding Name}">
              <TextBlock Text="{Binding Name}" MaxWidth="{Binding TitleWidth}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
            </CheckBox>
            <Border Grid.Column="1" Style="{StaticResource HintFocus}" CornerRadius="6" Padding="6,3" VerticalAlignment="Center" AutomationProperties.Name="{Binding ScoreAccessibleName}">
              <Border.ToolTip><ToolTip><TextBlock Text="{Binding ScoreDetails}" MaxWidth="430" TextWrapping="Wrap"/></ToolTip></Border.ToolTip>
              <TextBlock Text="{Binding ScoreText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding ScoreColor}"/>
            </Border>
          </Grid>
          <ItemsControl Grid.Row="1" ItemsSource="{Binding Services}" HorizontalAlignment="Center">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
              <Border Width="120" BorderBrush="#EDF0F4" BorderThickness="1,0,0,0">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource DashboardHalfTemplate}"/>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="185"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,18">
      <StackPanel><TextBlock Text="Zapret Tester" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Независимая проверка стратегий Discord, League of Legends и YouTube" Foreground="#5B6876" Margin="0,5,0,0"/></StackPanel>
      <TextBlock Text="{Binding Mode}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#087F8C" FontWeight="SemiBold"/>
    </DockPanel>
    <DockPanel Visibility="{Binding TestsVisibility}" Grid.Row="1" Margin="0,0,0,14">
      <Button DockPanel.Dock="Right" Content="Выбрать папку…" Command="{Binding ChooseFolderCommand}" Margin="10,0,0,0"/>
      <TextBox Text="{Binding Folder, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="Папка Flowseal"/>
    </DockPanel>
    <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTab}" Margin="0,0,0,12">
      <TabItem Header="Discord"/><TabItem Header="League of Legends"/><TabItem Header="YouTube"/><TabItem Header="Дашборд"/>
    </TabControl>
    <WrapPanel Visibility="{Binding TestsVisibility}" Grid.Row="3" Margin="0,0,0,14">
      <Button Content="Проверить всё" Command="{Binding TestAllCommand}" FontWeight="SemiBold"/>
      <Button Content="Остановить проверку" Command="{Binding CancelCommand}"/>
      <Button Content="Обновить" Command="{Binding RefreshCommand}"/>
      <Button Content="Настройки" Command="{Binding SettingsCommand}"/>
      <Button Content="Диагностика" Command="{Binding DiagnosticsCommand}"/>
      <Button Content="Журнал" Command="{Binding LogsCommand}"/>
    </WrapPanel>
    <StackPanel Grid.Row="3" Visibility="{Binding DashboardVisibility}" Margin="0,0,0,14">
      <WrapPanel Margin="0,0,0,10">
        <CheckBox Content="Discord" IsChecked="{Binding ShowDiscord}" Margin="0,4,16,0"/>
        <CheckBox Content="LoL" IsChecked="{Binding ShowLeague}" Margin="0,4,16,0"/>
        <CheckBox Content="YouTube" IsChecked="{Binding ShowYouTube}" Margin="0,4,24,0"/>
        <TextBlock Text="Порядок:" VerticalAlignment="Center" Foreground="#647386" Margin="0,0,7,0"/>
        <ComboBox SelectedIndex="{Binding DashboardSortIndex, Mode=TwoWay}" Width="155" Margin="0,0,20,0" VerticalContentAlignment="Center" AutomationProperties.Name="Порядок карточек">
          <ComboBoxItem Content="Лучшие сверху"/><ComboBoxItem Content="По названию"/>
        </ComboBox>
        <TextBlock Text="{Binding SelectionSummary}" Foreground="#647386" VerticalAlignment="Center" Margin="0,0,16,0"/>
        <TextBlock Text="{Binding SeriesSummary}" Foreground="#087F8C" VerticalAlignment="Center"/>
      </WrapPanel>
      <WrapPanel>
        <Button Content="Проверить все соединения" Command="{Binding TestBatchCommand}" FontWeight="SemiBold"/>
        <Button Content="Выбрать всё" Command="{Binding SelectAllCardsCommand}"/>
        <Button Content="Снять выбор" Command="{Binding ClearCardsCommand}"/>
        <Button Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Command="{Binding RefreshCommand}" ToolTip="Обновить сохранённую сводку" AutomationProperties.Name="Обновить сохранённую сводку"/>
        <Button Content="&#xE713;" FontFamily="Segoe MDL2 Assets" Command="{Binding SettingsCommand}" ToolTip="Настройки" AutomationProperties.Name="Настройки"/>
        <Button Content="&#xE71A;" FontFamily="Segoe MDL2 Assets" Command="{Binding CancelCommand}" ToolTip="Остановить текущую проверку" AutomationProperties.Name="Остановить текущую проверку"/>
      </WrapPanel>
    </StackPanel>
    <TextBlock Grid.Row="6" Text="{Binding MessageText}" Visibility="{Binding DashboardVisibility}" TextWrapping="Wrap" Foreground="#536171" MaxHeight="80" Margin="0,5,0,0"/>
    <ScrollViewer Grid.Row="4" Grid.RowSpan="2" Visibility="{Binding DashboardVisibility}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Карточки стратегий">
      <ItemsControl x:Name="DashboardList" Visibility="{Binding CardsVisibility}" ItemsSource="{Binding DashboardCardsView}" ItemTemplate="{StaticResource DashboardCardTemplate}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      </ItemsControl>
    </ScrollViewer>
    <Grid Grid.Row="4" Visibility="{Binding DashboardVisibility}" IsHitTestVisible="False">
      <TextBlock Visibility="{Binding EmptyServicesVisibility}" Text="Выберите хотя бы один сервис" Foreground="#647386" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
    <DataGrid Visibility="{Binding TestsVisibility}" Grid.Row="4" ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected}" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single"
              CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" HeadersVisibility="Column" RowHeight="39" BorderBrush="#D8DEE5" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF0F3" Background="White" AutomationProperties.Name="Результаты стратегий">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Стратегия" Binding="{Binding Name}" Width="2*" MinWidth="190"/>
        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="115"/>
        <DataGridTemplateColumn Header="0" Width="155"><DataGridTemplateColumn.HeaderTemplate><DataTemplate><TextBlock Text="{Binding DataContext.Header0, RelativeSource={RelativeSource AncestorType=DataGrid}}"/></DataTemplate></DataGridTemplateColumn.HeaderTemplate><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Content="{Binding Website}" ContentTemplate="{StaticResource EndpointTemplate}" Opacity="{Binding Opacity}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="1" Width="170"><DataGridTemplateColumn.HeaderTemplate><DataTemplate><TextBlock Text="{Binding DataContext.Header1, RelativeSource={RelativeSource AncestorType=DataGrid}}"/></DataTemplate></DataGridTemplateColumn.HeaderTemplate><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Content="{Binding Gateway}" ContentTemplate="{StaticResource EndpointTemplate}" Opacity="{Binding Opacity}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="2" Width="155"><DataGridTemplateColumn.HeaderTemplate><DataTemplate><TextBlock Text="{Binding DataContext.Header2, RelativeSource={RelativeSource AncestorType=DataGrid}}"/></DataTemplate></DataGridTemplateColumn.HeaderTemplate><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Content="{Binding Cdn}" ContentTemplate="{StaticResource EndpointTemplate}" Opacity="{Binding Opacity}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="3" Width="155"><DataGridTemplateColumn.HeaderTemplate><DataTemplate><TextBlock Text="{Binding DataContext.Header3, RelativeSource={RelativeSource AncestorType=DataGrid}}"/></DataTemplate></DataGridTemplateColumn.HeaderTemplate><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Content="{Binding UpdateEndpoint}" ContentTemplate="{StaticResource EndpointTemplate}" Opacity="{Binding Opacity}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTextColumn Header="Медиана" Binding="{Binding Latency}" Width="85"/>
        <DataGridTextColumn Header="Проверено" Binding="{Binding Timestamp}" Width="100"/>
      </DataGrid.Columns>
    </DataGrid>
    <Grid Visibility="{Binding TestsVisibility}" Grid.Row="5" Margin="0,14,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
      <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="White" AutomationProperties.Name="Детали выбранной стратегии"/>
      <StackPanel Grid.Column="1" Margin="14,0,0,0">
        <Button Content="Проверить выбранную" Command="{Binding TestOneCommand}" Margin="0,0,0,8"/>
        <Button Content="Сделать основным" Command="{Binding MainCommand}" Margin="0,0,0,8"/>
        <Button Content="Остановить основной" Command="{Binding StopMainCommand}" Margin="0,0,0,8"/>
        <Button Content="Восстановить Flowseal" Command="{Binding RestoreCommand}" Margin="0"/>
      </StackPanel>
    </Grid>
    <TextBlock Visibility="{Binding TestsVisibility}" Grid.Row="7" Text="{Binding SuiteNotice}" TextWrapping="Wrap" Foreground="#536171" Margin="0,8,0,0"/>
    <TextBox Visibility="{Binding TestsVisibility}" Grid.Row="6" Text="{Binding MessageText, Mode=OneWay}" IsReadOnly="True" Foreground="#536171" TextWrapping="Wrap" MaxHeight="95" VerticalScrollBarVisibility="Auto" Margin="0,5,0,0"/>
  </Grid>
</Window>
