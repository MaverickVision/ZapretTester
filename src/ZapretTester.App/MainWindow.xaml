<Window x:Name="RootWindow" x:Class="ZapretTester.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ZapretTester.App"
        Title="Zapret Tester" Icon="Assets/app.ico" Width="1390" Height="780" MinWidth="1150" MinHeight="650" Background="#F4F6F8" FontFamily="Segoe UI" FontSize="13" Foreground="#182533">
  <Window.Resources>
    <DataTemplate x:Key="EndpointTemplate">
      <StackPanel Orientation="Horizontal" ToolTip="{Binding Details}" VerticalAlignment="Center">
        <Ellipse Width="9" Height="9" Fill="{Binding Color}" Margin="0,0,7,0"/>
        <TextBlock Text="{Binding Text}" VerticalAlignment="Center"/>
      </StackPanel>
    </DataTemplate>

    <Style x:Key="HintFocus" TargetType="Border">
      <Setter Property="Focusable" Value="True"/>
      <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
      <EventSetter Event="GotKeyboardFocus" Handler="OpenHint"/>
      <EventSetter Event="LostKeyboardFocus" Handler="CloseHint"/>
      <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="#EFF4FA"/></Trigger></Style.Triggers>
    </Style>
    <DataTemplate x:Key="DashboardEndpointTemplate">
      <Border Style="{StaticResource HintFocus}" Width="27" Height="38" CornerRadius="5" Margin="1" AutomationProperties.Name="{Binding Details}">
        <Border.ToolTip><ToolTip><TextBlock Text="{Binding Details}" MaxWidth="380" TextWrapping="Wrap"/></ToolTip></Border.ToolTip>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding ServiceGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" Foreground="#647386"/>
          <TextBlock Text="{Binding Status.Glyph}" FontFamily="Segoe UI Symbol" Foreground="{Binding Status.Color}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Margin="0,3,0,0"/>
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="DashboardHalfTemplate">
      <StackPanel Margin="2,0">
        <Border Style="{StaticResource HintFocus}" Height="98" CornerRadius="9" AutomationProperties.Name="{Binding Details}">
          <Border.ToolTip><ToolTip><TextBlock Text="{Binding Details}" MaxWidth="400" TextWrapping="Wrap"/></ToolTip></Border.ToolTip>
          <Grid>
            <Viewbox Width="43" Height="37" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,7,0,0">
              <Grid Width="64" Height="54">
                <Canvas x:Name="DiscordLogo" Width="64" Height="54" Visibility="Collapsed">
                  <Path Fill="#5865F2" Data="M 14,10 Q 21,6 26,7 L 28,11 L 36,11 L 38,7 Q 47,7 52,12 Q 60,25 60,39 Q 51,47 44,46 L 41,41 Q 32,44 23,41 L 20,46 Q 10,45 4,39 Q 5,23 14,10 Z"/>
                  <Ellipse Width="8" Height="11" Fill="White" Canvas.Left="19" Canvas.Top="23"/><Ellipse Width="8" Height="11" Fill="White" Canvas.Left="37" Canvas.Top="23"/>
                </Canvas>
                <Canvas x:Name="LeagueLogo" Width="64" Height="54" Visibility="Collapsed">
                  <Ellipse Width="48" Height="48" Stroke="#B58B40" StrokeThickness="2.5" Canvas.Left="8" Canvas.Top="3"/>
                  <Path Fill="#B58B40" Data="M 21,8 L 36,8 L 32,13 L 32,38 L 49,38 L 45,46 L 20,46 L 24,40 L 24,13 Z"/>
                </Canvas>
                <Canvas x:Name="YouTubeLogo" Width="64" Height="54" Visibility="Collapsed">
                  <Rectangle Width="60" Height="40" RadiusX="11" RadiusY="11" Fill="#E53935" Canvas.Left="2" Canvas.Top="7"/>
                  <Path Fill="White" Data="M 27,17 L 43,27 L 27,37 Z"/>
                </Canvas>
                <Canvas x:Name="SteamLogo" Width="64" Height="54" Visibility="Collapsed">
                  <Ellipse Width="48" Height="48" Fill="#24384D" Canvas.Left="8" Canvas.Top="3"/>
                  <Path Stroke="White" StrokeThickness="6" Data="M 12,32 L 27,39 L 43,20"/>
                  <Ellipse Width="17" Height="17" Fill="#24384D" Stroke="White" StrokeThickness="3" Canvas.Left="34" Canvas.Top="12"/>
                  <Ellipse Width="11" Height="11" Fill="#24384D" Stroke="White" StrokeThickness="3" Canvas.Left="21" Canvas.Top="33"/>
                </Canvas>
                <Canvas x:Name="TwitchLogo" Width="64" Height="54" Visibility="Collapsed">
                  <Path Fill="#9146FF" Data="M 12,4 L 56,4 L 56,34 L 42,47 L 32,47 L 23,54 L 23,47 L 8,47 L 8,14 Z"/>
                  <Path Fill="White" Data="M 19,11 L 49,11 L 49,30 L 39,39 L 29,39 L 23,44 L 23,39 L 19,39 Z"/>
                  <Path Stroke="#9146FF" StrokeThickness="4" Data="M 30,18 L 30,29 M 41,18 L 41,29"/>
                </Canvas>
                <Canvas x:Name="CloudflareLogo" Width="64" Height="54" Visibility="Collapsed">
                  <Path Fill="#F48120" Data="M 5,39 Q 3,29 14,27 Q 12,11 28,9 Q 45,7 47,26 Q 57,24 60,34 L 59,41 L 5,41 Z"/>
                  <Path Stroke="White" StrokeThickness="3" Data="M 9,34 L 53,34"/>
                  <Path Fill="#FAAD3D" Data="M 43,41 Q 44,28 56,28 Q 64,28 64,41 Z"/>
                </Canvas>
              </Grid>
            </Viewbox>
            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center">
              <TextBlock Text="{Binding Status.Glyph}" FontFamily="Segoe UI Symbol" FontSize="24" FontWeight="Bold" Foreground="{Binding Status.Color}" HorizontalAlignment="Center"/>
              <TextBlock Text="{Binding Latency}" FontSize="13" Foreground="#536171" HorizontalAlignment="Center" Margin="0,1,0,2" AutomationProperties.Name="Отклик HTTPS, медиана без DNS"/>
            </StackPanel>
          </Grid>
        </Border>
        <ItemsControl ItemsSource="{Binding Endpoints}" ItemTemplate="{StaticResource DashboardEndpointTemplate}" HorizontalAlignment="Center">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsDiscord}" Value="True"><Setter TargetName="DiscordLogo" Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding IsLeague}" Value="True"><Setter TargetName="LeagueLogo" Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding IsYouTube}" Value="True"><Setter TargetName="YouTubeLogo" Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding IsSteam}" Value="True"><Setter TargetName="SteamLogo" Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding IsTwitch}" Value="True"><Setter TargetName="TwitchLogo" Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding IsCloudflare}" Value="True"><Setter TargetName="CloudflareLogo" Property="Visibility" Value="Visible"/></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="DashboardCardTemplate">
      <Border MinWidth="{Binding CardWidth}" Height="{Binding CardHeight}" Background="White" BorderBrush="{Binding AvailabilityColor}" BorderThickness="2" CornerRadius="12" Margin="0,0,14,14">
        <Grid Margin="10,9">
          <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="Предварительно" Visibility="{Binding PreliminaryVisibility}" Foreground="#647386" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0" ToolTip="Стратегия проверена; итог станет окончательным после подтверждения достоверности всей серии."/>
            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="3,1,8,0" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" ToolTip="Выбрать стратегию для следующей проверки"/>
            <Button Click="OpenCardDetails" Padding="0" Margin="0" MinHeight="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
            </Button>
          </DockPanel>
          <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource HintFocus}" Background="#F5F7FA" CornerRadius="6" Padding="4,2" AutomationProperties.Name="{Binding AvailabilityAccessibleName}">
              <Border.ToolTip><ToolTip><TextBlock Text="{Binding AvailabilityDetails}" MaxWidth="430" TextWrapping="Wrap"/></ToolTip></Border.ToolTip>
              <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Доступность" FontSize="10" Foreground="#536171" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding AvailabilityText}" FontSize="14" FontWeight="SemiBold" Foreground="{Binding AvailabilityColor}" HorizontalAlignment="Center"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource HintFocus}" Background="#F5F7FA" CornerRadius="6" Padding="4,2" AutomationProperties.Name="{Binding ResponseAccessibleName}">
              <Border.ToolTip><ToolTip><TextBlock Text="{Binding ResponseDetails}" MaxWidth="430" TextWrapping="Wrap"/></ToolTip></Border.ToolTip>
              <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Отклик HTTPS" FontSize="10" Foreground="#536171" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding ResponseText}" FontSize="14" FontWeight="SemiBold" Foreground="{Binding ResponseColor}" HorizontalAlignment="Center"/>
              </StackPanel>
            </Border>
          </Grid>
          <ItemsControl Grid.Row="2" ItemsSource="{Binding Services}" HorizontalAlignment="Stretch">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding ServiceColumns}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
              <Border Height="149" BorderBrush="#EDF0F4" BorderThickness="1,0,0,0">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource DashboardHalfTemplate}"/>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Zapret Tester" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Одна стратегия — выбранные сервисы — независимая проверка" Foreground="#5B6876" Margin="0,4,0,0"/></StackPanel>
      <TextBlock Grid.Column="1" Text="{Binding Mode}" VerticalAlignment="Center" Foreground="#087F8C" FontWeight="SemiBold" Margin="16,0,0,0"/>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="276"/></Grid.ColumnDefinitions>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
          <TextBlock Text="{Binding SeriesSummary}" Foreground="#087F8C" TextWrapping="Wrap">
            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding ActiveVariantSummary}" Foreground="#647386" FontSize="11" TextWrapping="Wrap">
            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding MainSummary}" TextTrimming="CharacterEllipsis" Foreground="#647386" ToolTip="{Binding MainSummary}"/>
        </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Карточки стратегий">
        <ItemsControl x:Name="DashboardList" Visibility="{Binding CardsVisibility}" ItemsSource="{Binding DashboardCardsView}" ItemTemplate="{StaticResource DashboardCardTemplate}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><local:AdaptiveCardPanel MinimumCardWidth="{Binding MinimumCardWidth}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
      </ScrollViewer>
      <TextBlock Visibility="{Binding EmptyServicesVisibility}" Text="Выберите хотя бы один сервис" Foreground="#647386" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <Border Grid.Column="1" Width="{Binding DetailsWidth}" Visibility="{Binding DetailsVisibility}" Background="White" BorderBrush="#D8DEE5" BorderThickness="1" CornerRadius="10" Margin="10,0,0,0" Padding="14">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,10">
            <DockPanel><Button DockPanel.Dock="Right" Content="×" Command="{Binding CloseDetailsCommand}" AutomationProperties.Name="Закрыть подробности" Padding="5,0" Margin="8,0,0,0" MinHeight="25"/><TextBlock Text="{Binding DetailTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/></DockPanel>
            <TextBlock Text="{Binding DetailSelection}" Foreground="#647386" TextWrapping="Wrap" Margin="0,6,0,0"/>
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding DetailServices}">
              <ItemsControl.ItemTemplate><DataTemplate>
                <StackPanel Margin="0,0,6,18">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/>
                  <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#536171" Margin="0,3,0,8"/>
                  <ItemsControl ItemsSource="{Binding Endpoints}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <Border BorderBrush="#EDF0F4" BorderThickness="0,0,0,1" Padding="0,7">
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding Address}" FontSize="10" Foreground="#647386" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                          <TextBlock Text="{Binding Measurements}" FontSize="11" Foreground="#536171" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="#8F4747" FontSize="11"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding Limitation}" TextWrapping="Wrap" Foreground="#647386" FontSize="11" Margin="0,8,0,0"/>
                </StackPanel>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <Button Content="Проверить эту стратегию" Command="{Binding TestOneCommand}" Margin="0,0,0,7"/>
            <Border Style="{StaticResource HintFocus}" AutomationProperties.Name="{Binding MainEligibility}">
              <Border.ToolTip><ToolTip><TextBlock Text="{Binding MainEligibility}" TextWrapping="Wrap" MaxWidth="320"/></ToolTip></Border.ToolTip>
              <Button Content="Сделать основным" Command="{Binding MainCommand}" Margin="0" ToolTip="{Binding MainEligibility}" ToolTipService.ShowOnDisabled="True"/>
            </Border>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
      </Grid>
      <Border Grid.Column="1" x:Name="ControlSidebar" Background="White" BorderBrush="#DFE5EC" BorderThickness="1" CornerRadius="12" Margin="16,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14" AutomationProperties.Name="Управление проверкой">
          <StackPanel>
            <StackPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Padding" Value="8,7"/></Style></StackPanel.Resources>
            <Grid x:Name="AnimationArea" Height="104" Margin="0,0,0,12">
              <local:ActivityLogo x:Name="WorkLogo" IsRunning="{Binding IsWorking}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Zapret Tester: индикатор работы"/>
            </Grid>
            <Button x:Name="TestSelectedButton" Content="Проверить выбранное" Command="{Binding TestBatchCommand}" Background="#0066FF" Foreground="White" BorderBrush="#0066FF" FontWeight="SemiBold" MinHeight="42"/>
            <Button x:Name="TestAllButton" Content="Проверить всё" Command="{Binding TestAllCommand}" MinHeight="38" ToolTip="Все найденные стратегии для отмеченных сервисов. Выбор карточек сохранится."/>
            <UniformGrid x:Name="ServiceSelection" Columns="2" Margin="0,5,0,14">
              <CheckBox Content="Discord" IsChecked="{Binding ShowDiscord}" Margin="0,4,4,5"/>
              <CheckBox Content="LoL" IsChecked="{Binding ShowLeague}" Margin="0,4,0,5"/>
              <CheckBox Content="YouTube" IsChecked="{Binding ShowYouTube}" Margin="0,4,4,5"/>
              <CheckBox Content="Steam" IsChecked="{Binding ShowSteam}" Margin="0,4,0,5"/>
              <CheckBox Content="Twitch" IsChecked="{Binding ShowTwitch}" Margin="0,4,4,5"/>
              <CheckBox Content="Cloudflare" IsChecked="{Binding ShowCloudflare}" Margin="0,4,0,5"/>
            </UniformGrid>
            <Button Content="Остановить проверку" Command="{Binding CancelCommand}"/>
            <Border x:Name="ConflictNotice" Visibility="{Binding RecoveryVisibility}" Background="#FFF6E8" BorderBrush="#E7C88F" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,6,0,12" ToolTip="{Binding MessageTechnicalDetails}">
              <StackPanel>
                <TextBlock Text="Проверке мешает другой Zapret" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding MessageText}" TextWrapping="Wrap" Foreground="#6D5126" Margin="0,6,0,10"/>
                <Button x:Name="PrepareConflictButton" Command="{Binding PrepareCommand}" Margin="0"><TextBlock Text="Подготовить Flowseal к проверке" TextWrapping="Wrap" TextAlignment="Center"/></Button>
              </StackPanel>
            </Border>
            <Separator Margin="0,8,0,12"/>
            <DockPanel Margin="0,0,0,8"><TextBlock Text="Стратегии" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectionSummary}" HorizontalAlignment="Right" Foreground="#647386"/></DockPanel>
            <UniformGrid Columns="2"><Button Content="Выбрать всё" Command="{Binding SelectAllCardsCommand}" Margin="0,0,4,8"/><Button Content="Снять выбор" Command="{Binding ClearCardsCommand}" Margin="4,0,0,8"/></UniformGrid>
            <TextBlock Text="Порядок карточек" Foreground="#647386" Margin="0,3,0,6"/>
            <ComboBox SelectedIndex="{Binding DashboardSortIndex, Mode=TwoWay}" VerticalContentAlignment="Center" MinHeight="32" Margin="0,0,0,10" AutomationProperties.Name="Порядок карточек">
              <ComboBoxItem Content="Лучшие сверху"/><ComboBoxItem Content="По названию"/>
            </ComboBox>
            <StackPanel Visibility="{Binding PortBudgetVisibility}" Margin="0,4,0,8">
              <TextBlock Text="{Binding PortBudgetMessage}" TextWrapping="Wrap" Foreground="#A56B12" Margin="0,0,0,8"/>
              <Button Content="Расширить пул" Command="{Binding ExpandPoolCommand}"/>
            </StackPanel>
            <Separator Margin="0,4,0,12"/>
            <TextBlock Text="Папка Flowseal" Foreground="#647386" Margin="0,0,0,6"/>
            <TextBox Text="{Binding Folder, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="72" VerticalScrollBarVisibility="Auto" FontSize="11" Margin="0,0,0,8" AutomationProperties.Name="Папка Flowseal"/>
            <Button Content="Выбрать папку…" Command="{Binding ChooseFolderCommand}"/>
            <UniformGrid Columns="2">
              <Button Content="Настройки" Command="{Binding SettingsCommand}" Margin="0,0,4,8"/>
              <Button Content="Обновить" Command="{Binding RefreshCommand}" Margin="4,0,0,8" ToolTip="Перечитать сохранённые результаты без сетевых проверок"/>
              <Button Content="Диагностика" Command="{Binding DiagnosticsCommand}" Margin="0,0,4,8"/>
              <Button Content="Журнал" Command="{Binding LogsCommand}" Margin="4,0,0,8"/>
            </UniformGrid>
            <Menu Background="#F4F6F8" Padding="3,7" Margin="0,2,0,10">
              <MenuItem Header="Управление основным">
                <MenuItem Header="Запустить сохранённый" Command="{Binding ResumeMainCommand}"/>
                <MenuItem Header="Подготовить Flowseal к проверке" Command="{Binding PrepareCommand}"/>
                <Separator/>
                <MenuItem Header="Остановить основной" Command="{Binding StopMainCommand}"/>
                <MenuItem Header="Восстановить Flowseal" Command="{Binding RestoreCommand}"/>
              </MenuItem>
            </Menu>
            <Button Content="FAQ" Click="OpenFaq" ToolTip="Коротко о показателях и настройке проверок"/>
            <Button Content="О программе" Click="OpenAbout"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <TextBox Grid.Row="2" Text="{Binding MessageText, Mode=OneWay}" Visibility="{Binding MessageFooterVisibility}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Foreground="#536171" MaxHeight="65" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"/>
  </Grid>
</Window>
